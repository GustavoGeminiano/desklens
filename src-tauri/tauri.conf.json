{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskLens",
  "version": "0.1.0",
  "identifier": "com.desklens.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeskLens",
        "width": 520,
        "height": 380,
        "center": true,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "hiddenTitle": true,
        "alwaysOnTop": true,
        "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
      },
      {
        "label": "results",
        "title": "DeskLens — Visual Search",
        "width": 430,
        "height": 720,
        "minWidth": 380,
        "minHeight": 520,
        "center": false,
        "visible": false,
        "skipTaskbar": false,
        "decorations": true,
        "alwaysOnTop": true,
        "url": "results.html",
        "userAgent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
